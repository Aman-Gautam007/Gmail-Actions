<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Gmail Advertisement synchronization and reminder-triggered cleanup. -->
<dict>
    <key>Label</key>
    <string>com.amangautam.gmail-advertisement-cleanup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/amangautam/Library/Application Support/Gmail-Actions/.venv/bin/python</string>
        <string>/Users/amangautam/Library/Application Support/Gmail-Actions/advertisement_cleanup.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/amangautam/Library/Application Support/Gmail-Actions/cleanup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/amangautam/Library/Application Support/Gmail-Actions/cleanup-error.log</string>
</dict>
</plist>
